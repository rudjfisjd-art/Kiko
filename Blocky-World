        <ProtectedString name="Source">-- Blocky World: lógica autoritativa do servidor. Compatível com avatares R6 e R15.
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)
local Debris = game:GetService(&quot;Debris&quot;)
local Catalog = require(ReplicatedStorage:WaitForChild(&quot;Catalog&quot;))

local STORE = DataStoreService:GetDataStore(&quot;BlockyWorld_PlayerData_v1&quot;)
local remotes = ReplicatedStorage:FindFirstChild(&quot;BlockyRemotes&quot;) or Instance.new(&quot;Folder&quot;)
remotes.Name = &quot;BlockyRemotes&quot;; remotes.Parent = ReplicatedStorage
local function remote(class, name)
    local r = remotes:FindFirstChild(name) or Instance.new(class); r.Name = name; r.Parent = remotes; return r
end
local GetState = remote(&quot;RemoteFunction&quot;, &quot;GetState&quot;)
local StateChanged = remote(&quot;RemoteEvent&quot;, &quot;StateChanged&quot;)
local BuyItem = remote(&quot;RemoteEvent&quot;, &quot;BuyItem&quot;)
local EquipWeapon = remote(&quot;RemoteEvent&quot;, &quot;EquipWeapon&quot;)
local PlaceBuild = remote(&quot;RemoteEvent&quot;, &quot;PlaceBuild&quot;)
local RemoveBuild = remote(&quot;RemoteEvent&quot;, &quot;RemoveBuild&quot;)
local Notify = remote(&quot;RemoteEvent&quot;, &quot;Notify&quot;)

local playerData, placedFolder = {}, nil
local lastAction = {}
local COLORS = {
    grass = Color3.fromRGB(64, 224, 68), darkgrass = Color3.fromRGB(44, 184, 63), pink = Color3.fromRGB(255, 94, 180),
    blue = Color3.fromRGB(53, 165, 255), orange = Color3.fromRGB(255, 151, 47), white = Color3.fromRGB(250, 250, 244),
    brown = Color3.fromRGB(126, 76, 42),
}

local function part(parent, name, size, cf, color, material)
    local p = Instance.new(&quot;Part&quot;); p.Name = name; p.Size = size; p.CFrame = cf; p.Anchored = true
    p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
    p.Color = color; p.Material = material or Enum.Material.SmoothPlastic; p.Parent = parent; return p
end
local function sign(parent, text, cf, width, height, color)
    local board = part(parent, &quot;VoxelSign&quot;, Vector3.new(width, height, 1), cf, color or COLORS.blue)
    local gui = Instance.new(&quot;SurfaceGui&quot;); gui.Face = Enum.NormalId.Front; gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud; gui.PixelsPerStud = 45; gui.Parent = board
    local label = Instance.new(&quot;TextLabel&quot;); label.Size = UDim2.fromScale(1,1); label.BackgroundTransparency = 1; label.Text = text; label.TextColor3 = Color3.new(1,1,1); label.TextStrokeTransparency = 0.35; label.Font = Enum.Font.GothamBlack; label.TextScaled = true; label.Parent = gui
    return board
end
local function tree(parent, x, z, scale)
    scale = scale or 1
    part(parent, &quot;SquareTrunk&quot;, Vector3.new(2,5,2)*scale, CFrame.new(x,2.5*scale,z), COLORS.brown, Enum.Material.Wood)
    part(parent, &quot;LeafCubeLower&quot;, Vector3.new(6,4,6)*scale, CFrame.new(x,6.5*scale,z), Color3.fromRGB(48,196,70))
    part(parent, &quot;LeafCubeUpper&quot;, Vector3.new(4,4,4)*scale, CFrame.new(x,10*scale,z), Color3.fromRGB(83,225,77))
end
local function tent(parent, x, z, title, canopyColor)
    local m = Instance.new(&quot;Model&quot;); m.Name = title .. &quot;_Booth&quot;; m.Parent = parent
    part(m,&quot;Counter&quot;,Vector3.new(12,3,5),CFrame.new(x,1.5,z),Color3.fromRGB(227,228,232))
    part(m,&quot;CounterTop&quot;,Vector3.new(12.5,.45,5.5),CFrame.new(x,3.2,z),Color3.fromRGB(255,255,255))
    for _,dx in ipairs({-5,5}) do for _,dz in ipairs({-2,2}) do part(m,&quot;CanopyPost&quot;,Vector3.new(.5,5,.5),CFrame.new(x+dx,2.5,z+dz),Color3.fromRGB(245,245,245)) end end
    for i=1,6 do
        local stripe = part(m,&quot;StripedCanopy&quot;,Vector3.new(2,1,6),CFrame.new(x-5.5+(i-1)*2,5.3,z),i%2==0 and COLORS.white or canopyColor)
    end
    sign(m,title,CFrame.new(x,7.2,z-3.5),13,2.5,canopyColor)
end

local function buildMap()
    if workspace:FindFirstChild(&quot;BlockyWorldMap&quot;) then return end
    local map = Instance.new(&quot;Folder&quot;); map.Name = &quot;BlockyWorldMap&quot;; map.Parent = workspace
    Lighting.ClockTime = 13.5; Lighting.Brightness = 2.2; Lighting.Ambient = Color3.fromRGB(150,178,205); Lighting.OutdoorAmbient = Color3.fromRGB(175,198,220)
    Lighting.EnvironmentDiffuseScale = .7; Lighting.EnvironmentSpecularScale = .35
    local sky = Lighting:FindFirstChildOfClass(&quot;Sky&quot;) or Instance.new(&quot;Sky&quot;); sky.Parent = Lighting
    sky.SkyboxBk = &quot;rbxasset://sky/sky512_bk.tex&quot;; sky.SkyboxDn = &quot;rbxasset://sky/sky512_dn.tex&quot;; sky.SkyboxFt = &quot;rbxasset://sky/sky512_ft.tex&quot;; sky.SkyboxLf = &quot;rbxasset://sky/sky512_lf.tex&quot;; sky.SkyboxRt = &quot;rbxasset://sky/sky512_rt.tex&quot;; sky.SkyboxUp = &quot;rbxasset://sky/sky512_up.tex&quot;
    part(map,&quot;MainGrassArena&quot;,Vector3.new(220,2,170),CFrame.new(0,-1,0),COLORS.grass,Enum.Material.Grass)
    -- Anel de montanhas em blocos verdes e rosas, com simetria nos dois lados.
    for side=-1,1,2 do
        for i=1,8 do
            local x=side*(55+i*7); local h=10+(i%4)*5
            part(map,&quot;GreenVoxelHill&quot;,Vector3.new(14,h,18),CFrame.new(x,h/2-1,0),i%3==0 and COLORS.pink or Color3.fromRGB(65,193,70),Enum.Material.Grass)
            part(map,&quot;PinkVoxelWall&quot;,Vector3.new(12,10+(i%3)*4,9),CFrame.new(side*(112),4+(i%3)*2, -65+i*18),i%2==0 and COLORS.pink or Color3.fromRGB(113,203,71),Enum.Material.SmoothPlastic)
        end
    end
    -- Muralhas baixas e entrada principal ao fundo.
    for x=-105,105,14 do part(map,&quot;BackWallBlock&quot;,Vector3.new(14,12,8),CFrame.new(x,5,-82),x%2==0 and Color3.fromRGB(70,194,72) or COLORS.pink) end
    part(map,&quot;GatePillar&quot;,Vector3.new(10,23,10),CFrame.new(-16,10.5,-77),COLORS.pink)
    part(map,&quot;GatePillar&quot;,Vector3.new(10,23,10),CFrame.new(16,10.5,-77),Color3.fromRGB(76,206,81))
    part(map,&quot;GateHeader&quot;,Vector3.new(42,7,10),CFrame.new(0,22,-77),COLORS.blue)
    sign(map,&quot;BLOCKY WORLD&quot;,CFrame.new(0,22,-71.5),25,4,COLORS.blue)
    -- Áreas de lojas laterais, com plataformas/caminhos azuis e barracas listradas.
    part(map,&quot;BlueWalkwayLeft&quot;,Vector3.new(30,1,100),CFrame.new(-78,-.35,5),COLORS.blue)
    part(map,&quot;BlueWalkwayRight&quot;,Vector3.new(30,1,100),CFrame.new(78,-.35,5),COLORS.blue)
    part(map,&quot;BuildingsPlaza&quot;,Vector3.new(36,1,32),CFrame.new(-78,-.2,-28),Color3.fromRGB(93,190,255))
    part(map,&quot;WeaponsPlaza&quot;,Vector3.new(36,1,32),CFrame.new(78,-.2,-28),Color3.fromRGB(255,183,94))
    tent(map,-78,-25,&quot;BUILDINGS&quot;,COLORS.blue); tent(map,78,-25,&quot;WEAPONS&quot;,COLORS.orange)
    sign(map,&quot;CONSTRUA SEU MUNDO&quot;,CFrame.new(-78,10,-43),18,3,Color3.fromRGB(43,134,255))
    sign(map,&quot;EQUIPAMENTOS&quot;,CFrame.new(78,10,-43),18,3,Color3.fromRGB(242,125,32))
    -- Prédios decorativos e elementos simétricos no entorno.
    for side=-1,1,2 do
        local sx=side*44
        part(map,&quot;DecorShop&quot;,Vector3.new(18,10,16),CFrame.new(sx,5,23),side&lt;0 and Color3.fromRGB(92,159,250) or Color3.fromRGB(251,145,67))
        part(map,&quot;DecorRoof&quot;,Vector3.new(20,2,18),CFrame.new(sx,11,23),side&lt;0 and COLORS.blue or COLORS.orange)
        sign(map,side&lt;0 and &quot;PIXEL HOME&quot; or &quot;GEAR BOX&quot;,CFrame.new(sx,8,14.4),14,2,side&lt;0 and COLORS.blue or COLORS.orange)
        for _,z in ipairs({-64,-35,8,48,65}) do tree(map,side*(30+(z%3)*7),z,1+(math.abs(z)%2)*.15) end
    end
    -- Placas cuadriculadas decorativas, faróis e bancos.
    for x=-30,30,15 do
        part(map,&quot;BluePathTile&quot;,Vector3.new(10,.3,7),CFrame.new(x,.1,-53),Color3.fromRGB(72,177,255))
        part(map,&quot;PixelLamp&quot;,Vector3.new(1,7,1),CFrame.new(x,3,54),Color3.fromRGB(45,83,130))
        part(map,&quot;LampGlow&quot;,Vector3.new(3,1,3),CFrame.new(x,7,54),Color3.fromRGB(255,239,120),Enum.Material.Neon)
    end
    local spawn=Instance.new(&quot;SpawnLocation&quot;); spawn.Name=&quot;BlockySpawn&quot;; spawn.Size=Vector3.new(10,1,10); spawn.Position=Vector3.new(0,.5,55); spawn.Anchored=true; spawn.Neutral=true; spawn.Color=Color3.fromRGB(255,238,105); spawn.Material=Enum.Material.Neon; spawn.Parent=map
    local plot=Instance.new(&quot;Folder&quot;); plot.Name=&quot;PlayerBuilds&quot;; plot.Parent=workspace; placedFolder=plot
end

local function defaultData()
    return {coins=500,ownedBuildings=table.clone(Catalog.DefaultOwned.buildings),ownedWeapons=table.clone(Catalog.DefaultOwned.weapons),equipped=&quot;FoamSword&quot;,builds={}}
end
local function sanitize(raw)
    local d=defaultData()
    if type(raw)==&quot;table&quot; then
        if type(raw.coins)==&quot;number&quot; then d.coins=math.clamp(math.floor(raw.coins),0,1000000) end
        for _,key in ipairs({&quot;ownedBuildings&quot;,&quot;ownedWeapons&quot;}) do
            if type(raw[key])==&quot;table&quot; then
                local set={}; for _,name in ipairs(raw[key]) do if type(name)==&quot;string&quot; and ((key==&quot;ownedBuildings&quot; and Catalog.Buildings[name]) or (key==&quot;ownedWeapons&quot; and Catalog.Weapons[name])) then set[name]=true end end
                for _,starter in ipairs(Catalog.DefaultOwned[key==&quot;ownedBuildings&quot; and &quot;buildings&quot; or &quot;weapons&quot;]) do set[starter]=true end
                d[key]={}; for name in pairs(set) do table.insert(d[key],name) end
            end
        end
        if Catalog.Weapons[raw.equipped] then d.equipped=raw.equipped end
        if type(raw.builds)==&quot;table&quot; then for _,b in ipairs(raw.builds) do
            if #d.builds&gt;=60 then break end
            if type(b)==&quot;table&quot; and Catalog.Buildings[b.name] and type(b.x)==&quot;number&quot; and type(b.z)==&quot;number&quot; and type(b.rot)==&quot;number&quot; and math.abs(b.x)&lt;=48 and math.abs(b.z)&lt;=42 then
                table.insert(d.builds,{name=b.name,x=math.clamp(b.x,-48,48),z=math.clamp(b.z,-42,40),rot=math.floor(b.rot/90+.5)%4*90})
            end
        end end
    end
    return d
end
local function snapshot(player)
    local d=playerData[player]; if not d then return nil end
    return {coins=d.coins,ownedBuildings=table.clone(d.ownedBuildings),ownedWeapons=table.clone(d.ownedWeapons),equipped=d.equipped}
end
local function notify(player,msg,kind) Notify:FireClient(player,msg,kind or &quot;info&quot;) end
local function push(player)
    local d=playerData[player]; if not d then return end
    local stats=player:FindFirstChild(&quot;leaderstats&quot;); if stats and stats:FindFirstChild(&quot;Coins&quot;) then stats.Coins.Value=d.coins end
    StateChanged:FireClient(player,snapshot(player))
end
local function save(player)
    local d=playerData[player]; if not d then return end
    local ok,err=pcall(function() STORE:SetAsync(&quot;u_&quot;..player.UserId,d) end)
    if not ok then warn(&quot;BlockyWorld: falha ao salvar&quot;,player.UserId,err) end
end

local function addBlock(model,name,size,offset,color,material)
    local p=Instance.new(&quot;Part&quot;); p.Name=name; p.Size=size; p.Anchored=true; p.CanCollide=true; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic; p.CFrame=model:GetPivot()*CFrame.new(offset); p.Parent=model; return p
end
local function makeBuild(name,position,rotation,ownerId)
    local info=Catalog.Buildings[name]; if not info then return nil end
    local model=Instance.new(&quot;Model&quot;); model.Name=name; model:SetAttribute(&quot;OwnerUserId&quot;,ownerId); model:SetAttribute(&quot;BuildingKey&quot;,name)
    local pivot=CFrame.new(position)*CFrame.Angles(0,math.rad(rotation),0); model:PivotTo(pivot)
    local c=info.color
    if info.kind==&quot;house&quot; then
        addBlock(model,&quot;HouseBody&quot;,Vector3.new(8,5,8),Vector3.new(0,2.5,0),c)
        addBlock(model,&quot;Roof&quot;,Vector3.new(9,2,9),Vector3.new(0,6,0),Color3.fromRGB(216,80,88))
        addBlock(model,&quot;Door&quot;,Vector3.new(1.5,3,.25),Vector3.new(0,1.5,-4.15),Color3.fromRGB(111,72,48))
        addBlock(model,&quot;WindowLeft&quot;,Vector3.new(1.5,1.5,.3),Vector3.new(-2,3,-4.16),Color3.fromRGB(106,218,255),Enum.Material.Glass)
        addBlock(model,&quot;WindowRight&quot;,Vector3.new(1.5,1.5,.3),Vector3.new(2,3,-4.16),Color3.fromRGB(106,218,255),Enum.Material.Glass)
    elseif info.kind==&quot;tower&quot; then
        addBlock(model,&quot;TowerBase&quot;,Vector3.new(6,9,6),Vector3.new(0,4.5,0),c)
        addBlock(model,&quot;TowerCrown&quot;,Vector3.new(8,3,8),Vector3.new(0,10.5,0),Color3.fromRGB(150,218,255))
        addBlock(model,&quot;TowerFlag&quot;,Vector3.new(.5,4,.5),Vector3.new(0,14,0),Color3.fromRGB(255,238,91))
    elseif info.kind==&quot;bridge&quot; then
        addBlock(model,&quot;BridgeDeck&quot;,Vector3.new(12,1.5,5),Vector3.new(0,.75,0),c)
        for x=-5,5,2 do addBlock(model,&quot;BridgeTile&quot;,Vector3.new(.2,1.7,5),Vector3.new(x,1.6,0),Color3.fromRGB(185,236,255)) end
    elseif info.kind==&quot;castle&quot; then
        addBlock(model,&quot;CastleHall&quot;,Vector3.new(8,8,8),Vector3.new(0,4,0),c)
        for _,x in ipairs({-5,5}) do for _,z in ipairs({-5,5}) do addBlock(model,&quot;Turret&quot;,Vector3.new(3,12,3),Vector3.new(x,6,z),Color3.fromRGB(237,137,207)) end end
        addBlock(model,&quot;CastleDoor&quot;,Vector3.new(2,4,.3),Vector3.new(0,2,-4.2),Color3.fromRGB(121,74,143))
    elseif info.kind==&quot;tree&quot; then
        addBlock(model,&quot;Trunk&quot;,Vector3.new(2,5,2),Vector3.new(0,2.5,0),COLORS.brown,Enum.Material.Wood)
        addBlock(model,&quot;LeavesLower&quot;,Vector3.new(6,4,6),Vector3.new(0,6.5,0),Color3.fromRGB(53,201,68))
        addBlock(model,&quot;LeavesTop&quot;,Vector3.new(4,4,4),Vector3.new(0,10,0),Color3.fromRGB(96,230,75))
    elseif info.kind==&quot;fence&quot; then
        addBlock(model,&quot;FenceRail&quot;,Vector3.new(8,.6,.7),Vector3.new(0,2.3,0),c)
        addBlock(model,&quot;FenceRail&quot;,Vector3.new(8,.6,.7),Vector3.new(0,.8,0),Color3.fromRGB(255,245,188))
        for x=-3,3,2 do addBlock(model,&quot;FencePost&quot;,Vector3.new(.7,3,.9),Vector3.new(x,1.5,0),Color3.fromRGB(245,160,79)) end
    end
    model.Parent=placedFolder; return model
end
local function restoreBuilds(player)
    local d=playerData[player]; if not d then return end
    for _,b in ipairs(d.builds) do makeBuild(b.name,Vector3.new(b.x,0,b.z),b.rot,player.UserId) end
end
local function owned(list,name) return table.find(list,name)~=nil end
local function throttle(player,kind,interval)
    local now=os.clock(); lastAction[player]=lastAction[player] or {}
    if now-(lastAction[player][kind] or 0)&lt;interval then return false end
    lastAction[player][kind]=now; return true
end
local function finiteNumber(n)
    return type(n)==&quot;number&quot; and n==n and n&gt;-math.huge and n&lt;math.huge
end

local function createWeaponTool(player,key)
    local data=Catalog.Weapons[key]; if not data then return end
    local backpack=player:FindFirstChildOfClass(&quot;Backpack&quot;); if not backpack then return end
    for _,container in ipairs({backpack,player.Character}) do if container then for _,obj in ipairs(container:GetChildren()) do if obj:IsA(&quot;Tool&quot;) and obj:GetAttribute(&quot;BlockyWeapon&quot;) then obj:Destroy() end end end end
    local tool=Instance.new(&quot;Tool&quot;); tool.Name=data.display; tool.RequiresHandle=true; tool.CanBeDropped=false; tool:SetAttribute(&quot;BlockyWeapon&quot;,true)
    local handle=Instance.new(&quot;Part&quot;); handle.Name=&quot;Handle&quot;; handle.Size=key==&quot;FoamSword&quot; and Vector3.new(.65,4,.8) or Vector3.new(1,1,2.4); handle.Color=data.color; handle.Material=Enum.Material.Neon; handle.Anchored=false; handle.CanCollide=false; handle.Massless=true; handle.Parent=tool
    tool:SetAttribute(&quot;WeaponKey&quot;,key)
    local busy=false
    tool.Activated:Connect(function()
        if busy or tool.Parent~=player.Character then return end
        busy=true; task.delay(.55,function() busy=false end)
        local char=player.Character; local hum=char and char:FindFirstChildOfClass(&quot;Humanoid&quot;); local root=char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
        if not hum or hum.Health&lt;=0 or not root then return end
        local weapon=Catalog.Weapons[key]; if not weapon then return end
        local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={char}
        local result=workspace:Raycast(root.Position+Vector3.new(0,1,0),root.CFrame.LookVector*weapon.range,params)
        if result then
            local target=result.Instance:FindFirstAncestorOfClass(&quot;Model&quot;); local targetHumanoid=target and target:FindFirstChildOfClass(&quot;Humanoid&quot;)
            if targetHumanoid and target~=char and targetHumanoid.Health&gt;0 then targetHumanoid:TakeDamage(weapon.damage) end
        end
    end)
    tool.Parent=backpack
end

buildMap()
GetState.OnServerInvoke=function(player) return snapshot(player) end
BuyItem.OnServerEvent:Connect(function(player,category,key)
    if not throttle(player,&quot;buy&quot;,.25) then return end
    local d=playerData[player]; if not d then return end
    local catalog,list
    if category==&quot;building&quot; then catalog=Catalog.Buildings; list=d.ownedBuildings elseif category==&quot;weapon&quot; then catalog=Catalog.Weapons; list=d.ownedWeapons else return end
    local item=catalog[key]; if not item then return end
    if owned(list,key) then notify(player,&quot;Você já possui &quot;..item.display..&quot;.&quot;,&quot;info&quot;); return end
    if d.coins&lt;item.price then notify(player,&quot;Moedas insuficientes.&quot;,&quot;error&quot;); return end
    d.coins-=item.price; table.insert(list,key); push(player); save(player); notify(player,item.display..&quot; comprado!&quot;,&quot;success&quot;)
end)
EquipWeapon.OnServerEvent:Connect(function(player,key)
    local d=playerData[player]; if not d or not throttle(player,&quot;equip&quot;,.3) or not Catalog.Weapons[key] or not owned(d.ownedWeapons,key) then return end
    d.equipped=key; createWeaponTool(player,key); push(player); save(player); notify(player,&quot;Equipado: &quot;..Catalog.Weapons[key].display,&quot;success&quot;)
end)
